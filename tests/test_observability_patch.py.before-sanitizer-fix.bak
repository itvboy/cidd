from pathlib import Path
import json
from cidd.contracts.materializer import derive_entity_interface
from cidd.engine.generation import generate_graph
from cidd.contracts.materializer import build_graph, write_graph
from cidd.providers.base import LLMProvider, LLMResponse


def test_todo_sealed_constructor():
    entry = {'name':'Todo','fields':[
        {'name':'id','type':'int','nullable':True},
        {'name':'title','type':'string','required':True},
        {'name':'completed','type':'bool','default':False}]}
    text = derive_entity_interface(entry, 'dart')
    assert 'Todo({this.id, required this.title, this.completed = false});' in text


class FencedProvider(LLMProvider):
    def generate(self, system_prompt, user_prompt):
        return LLMResponse(content='```dart\nclass Todo {}\n```', input_tokens=11, output_tokens=10)


def test_invalid_output_is_preserved(tmp_path):
    genome = {'genome':'0.1', 'project':{'name':'todo','template':'flutter','language':'dart'},
              'domain':{'entities':[{'name':'Todo','fields':[{'name':'id','type':'int'}]}]},
              'application':{'use_cases':[]}, 'infrastructure':{'persistence':[]},
              'presentation':{'framework':'flutter','screens':[]}}
    graph = tmp_path/'graph.json'
    write_graph(build_graph(genome),graph)
    result = generate_graph(graph,tmp_path/'runs',FencedProvider())
    entry = result['results'][0]
    assert entry['status'] == 'FAILED'
    assert (Path(result['run_dir'])/entry['raw_response_path']).read_text() == '```dart\nclass Todo {}\n```'
    assert entry['output_tokens'] == 10
